# Backend and MCP service ports
API_PORT=8080
CRM_MCP_PORT=8081
ECOMMERCE_MCP_PORT=8082

# Spring Boot MCP client endpoints
CRM_MCP_URL=http://localhost:8081
ECOMMERCE_MCP_URL=http://localhost:8082

# CRM PostgreSQL (use a dedicated read-only account)
CRM_DB_URL=replace-with-local-postgresql-jdbc-url
CRM_DB_USERNAME=replace-with-crm-read-only-username
CRM_DB_PASSWORD=replace-with-local-secret

# E-Commerce MySQL (use a dedicated read-only account)
ECOMMERCE_DB_URL=replace-with-local-mysql-jdbc-url
ECOMMERCE_DB_USERNAME=replace-with-ecommerce-read-only-username
ECOMMERCE_DB_PASSWORD=replace-with-local-secret

# Frontend API origin
VITE_API_BASE_URL=http://localhost:8080
